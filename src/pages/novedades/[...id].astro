---
import { getCollection, render } from "astro:content";
import BaseLayout from '../../layouts/BaseLayout.astro'
import NovedadCard from "../../components/NovedadCard.astro";
import { CATEGORIAS, NOMBRE_SITIO, fechaLarga, fechaISO, jsonSeguro } from "../../utils/novedades";

export async function getStaticPaths() {
  const novedades = await getCollection("novedades", ({ data }) => !data.draft);
  return novedades.map((n) => ({ params: { id: n.id }, props: { n } }));
}

const { n } = Astro.props;
const { Content } = await render(n);
const cat = CATEGORIAS[n.data.category as keyof typeof CATEGORIAS];
const SITE = Astro.site?.origin ?? "https://vivirsinprivilegios.org";
const url = `${SITE}/novedades/${n.id}/`;

const relacionadas = (await getCollection("novedades", ({ data }) => !data.draft && data.category === n.data.category))
  .filter((o) => o.id !== n.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const autor = { "@type": "Organization", name: NOMBRE_SITIO, url: SITE };
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: n.data.title.slice(0, 110),
      description: n.data.description,
      datePublished: fechaISO(n.data.pubDate),
      dateModified: fechaISO(n.data.checkedDate),
      inLanguage: "es",
      articleSection: cat.nombre,
      mainEntityOfPage: url,
      isBasedOn: n.data.sourceUrl,
      author: autor,
      publisher: autor,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE}/` },
        { "@type": "ListItem", position: 2, name: "Novedades", item: `${SITE}/novedades/` },
        { "@type": "ListItem", position: 3, name: cat.nombre, item: `${SITE}/novedades/categoria/${n.data.category}/` },
        { "@type": "ListItem", position: 4, name: n.data.title, item: url },
      ],
    },
  ],
};
---

<BaseLayout title={n.data.title} description={n.data.description}>
  <script is:inline type="application/ld+json" set:html={jsonSeguro(jsonLd)} />

  <main class="novedad app-container pt-36 pb-16">
    <nav class="migas" aria-label="Migas de pan">
      <a href="/">Inicio</a> › <a href="/novedades/">Novedades</a> ›
      <a href={`/novedades/categoria/${n.data.category}/`}>{cat.nombre}</a>
    </nav>

    <article>
      <header>
        <p class="meta">
          <a class="etiqueta" href={`/novedades/categoria/${n.data.category}/`}>{cat.nombre}</a>
          <span>Publicado: <time datetime={fechaISO(n.data.pubDate)}>{fechaLarga(n.data.pubDate)}</time></span>
          <span>Última comprobación: <time datetime={fechaISO(n.data.checkedDate)}>{fechaLarga(n.data.checkedDate)}</time></span>
        </p>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight mb-4">{n.data.title}</h1>
        <p class="lead">{n.data.description}</p>
      </header>

      <div class="contenido"><Content /></div>

      <aside class="fuente" aria-label="Fuente oficial">
        <p>
          <strong>Fuente oficial:</strong>
          <a href={n.data.sourceUrl} target="_blank" rel="noopener noreferrer">{n.data.source}</a>
        </p>
        <p class="aviso">
          Información orientativa, no constituye asesoría jurídica. Contrasta siempre con la
          fuente oficial antes de tomar decisiones sobre tu trámite.
        </p>
      </aside>
    </article>

    {relacionadas.length > 0 && (
      <section class="relacionadas">
        <h2 class="text-2xl font-bold mb-4">Más novedades de {cat.nombre.toLowerCase()}</h2>
        <div class="lista">
          {relacionadas.map((r) => <NovedadCard n={r} />)}
        </div>
        <p><a href="/novedades/">Ver todas las novedades →</a></p>
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .novedad {
    max-width: 46rem;
    margin: 0 auto;
  }

  .migas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: color-mix(in srgb, currentColor 72%, transparent);
    margin-bottom: 1.25rem;
  }

  .migas a {
    color: inherit;
    text-decoration: none;
  }

  .migas a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    font-size: 0.85rem;
    color: color-mix(in srgb, currentColor 78%, transparent);
    margin: 0 0 0.9rem;
  }

  .etiqueta {
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
    color: inherit;
    background: color-mix(in srgb, currentColor 11%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }

  .etiqueta:hover {
    background: color-mix(in srgb, currentColor 18%, transparent);
  }

  .lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: color-mix(in srgb, currentColor 82%, transparent);
    margin: 0 0 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
  }

  .contenido {
    line-height: 1.7;
  }

  .contenido :global(h2) {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 2rem 0 0.75rem;
  }

  .contenido :global(p) {
    margin: 0 0 1rem;
  }

  .contenido :global(ul) {
    list-style: disc;
    padding-left: 1.35rem;
    margin: 0 0 1.25rem;
  }

  .contenido :global(li) {
    margin-bottom: 0.45rem;
  }

  .fuente {
    margin-top: 2.25rem;
    padding: 1.1rem 1.25rem;
    border-radius: 12px;
    border-left: 4px solid currentColor;
    background: color-mix(in srgb, currentColor 6%, transparent);
  }

  .fuente p {
    margin: 0;
  }

  .fuente a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .aviso {
    font-size: 0.88rem;
    color: color-mix(in srgb, currentColor 78%, transparent);
    margin-top: 0.5rem !important;
  }

  .relacionadas {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid color-mix(in srgb, currentColor 14%, transparent);
  }

  .lista {
    display: grid;
    gap: 1rem;
    margin-bottom: 1rem;
  }
</style>