	<script>
		const inputBuscador = document.getElementById('buscador-guias') as HTMLInputElement | null;
		const grupos = document.querySelectorAll('.grupo-guias');
		const mensajeVacio = document.getElementById('sin-resultados-guias');

		const normalizar = (texto: string) =>
			texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

		inputBuscador?.addEventListener('input', () => {
			const termino = normalizar(inputBuscador.value.trim());
			let totalVisibles = 0;

			grupos.forEach((grupo) => {
				const items = grupo.querySelectorAll('.item-guia');
				let visiblesEnGrupo = 0;

				items.forEach((item) => {
					const contenido = normalizar(item.getAttribute('data-search') || '');
					const coincide = contenido.includes(termino);
					(item as HTMLElement).style.display = coincide ? '' : 'none';
					if (coincide) {
						visiblesEnGrupo++;
						totalVisibles++;
					}
				});

				(grupo as HTMLElement).style.display = visiblesEnGrupo > 0 ? '' : 'none';
			});

			if (mensajeVacio) {
				mensajeVacio.classList.toggle('hidden', totalVisibles > 0);
			}
		});
	</script>
