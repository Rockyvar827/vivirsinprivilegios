---
import BaseLayout from '../../layouts/BaseLayout.astro'
import QuizTarea5 from '../../components/QuizTarea5.astro'
---

<BaseLayout title="Examen CCSE Tarea 5 · Guía de Extranjería Galicia" description="Cuestionario de práctica de la Tarea 5 del examen CCSE, con corrección y explicación en cada pregunta.">
	<main class="app-container pt-36">
		<p class="text-sm uppercase tracking-wide text-gray-500 pb-2">
			<a href="/extranjeria" class="hover:underline">Extranjería</a> / Examen CCSE / Tarea 5
		</p>
		<h1 class="text-6xl pb-8 font-bold">Sociedad española</h1>
		<p class="md:w-2/3 text-lg leading-[2rem] pb-8">
			Cuestionario de práctica de la Tarea 5, con corrección y
			explicación en cada pregunta, basado en el manual oficial
			del Instituto Cervantes.
		</p>
	</main>
	<section class="app-container py-12">
		<QuizTarea5 />
	</section>
</BaseLayout>
