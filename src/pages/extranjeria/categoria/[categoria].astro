---
import { getCollection } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import ExtranjeriaCard from '../../../components/ExtranjeriaCard.astro'
import ExtranjeriaNav from '../../../components/ExtranjeriaNav.astro'
import { resumenCategoriasExtranjeria } from '../../../utils/extranjeria'

export async function getStaticPaths() {
	const posts = (await getCollection('extranjeria')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	)
	const categorias = resumenCategoriasExtranjeria(posts)

	return categorias.map((cat) => ({
		params: { categoria: cat.slug },
		props: {
			cat,
			categorias,
			filtrados: posts.filter((p) => p.data.category === cat.slug),
		},
	}))
}

const { cat, categorias, filtrados } = Astro.props
---

<BaseLayout
	title={`${cat.nombre} — Guía de Extranjería en Galicia`}
	description={`Trámites, requisitos y guías actualizadas sobre ${cat.nombre.toLowerCase()} en Galicia.`}
>
	<main class="app-container pt-36">
		<h1 class="text-6xl pb-8 font-bold">{cat.nombre}</h1>
		<p class="md:w-2/3 text-lg leading-[2rem]">
			Consulta los pasos, requisitos y tasas actualizadas sobre {cat.nombre.toLowerCase()} en Galicia.
		</p>
		<ExtranjeriaNav categorias={categorias} activa={cat.slug} />
	</main>

	<section class="app-container py-12">
		<ul class="posts-grid-container">
			{
				filtrados.map((post) => (
					<li>
						<ExtranjeriaCard post={post} />
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>