---
import { getCollection, type CollectionEntry } from 'astro:content'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import BlogNav from '../../../components/BlogNav.astro'
import { resumenCategoriasBlog } from '../../../utils/blog'
import BlogCard from '../../../components/BlogCard.astro'

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	)
	const categorias = resumenCategoriasBlog(posts)

	return categorias.map((cat) => ({
		params: { categoria: cat.slug },
		props: {
			cat,
			categorias,
			filtrados: posts.filter((p) => p.data.category === cat.slug),
		},
	}))
}

const { cat, categorias, filtrados } = Astro.props as {
	cat: ReturnType<typeof resumenCategoriasBlog>[number]
	categorias: ReturnType<typeof resumenCategoriasBlog>
	filtrados: CollectionEntry<'blog'>[]
}
---

<BaseLayout
	title={`${cat.nombre} — Blog`}
	description={`Artículos y ensayos sobre ${cat.nombre.toLowerCase()}.`}
>
	<main class="app-container pt-36">
		<h1 class="text-6xl pb-8 font-bold">{cat.nombre}</h1>
		<p class="md:w-2/3 text-lg leading-[2rem]">
			Artículos y análisis sobre {cat.nombre.toLowerCase()}.
		</p>
		<BlogNav categorias={categorias} activa={cat.slug} />
	</main>

	<section class="app-container py-12">
		<ul class="posts-grid-container">
			{
				filtrados.map((post) => (
					<li>
						<BlogCard post={post} />
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>