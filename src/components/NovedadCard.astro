---
import { CATEGORIAS, fechaLarga, fechaISO } from "../utils/novedades";
const { n } = Astro.props;
const cat = CATEGORIAS[n.data.category as keyof typeof CATEGORIAS];
---

<article class="post-card">
  <header class="post-top">
    <a class="post-badge" href={`/novedades/categoria/${n.data.category}/`}>
      {cat.nombre}
    </a>
    <time class="post-date" datetime={fechaISO(n.data.pubDate)}>
      {fechaLarga(n.data.pubDate)}
    </time>
  </header>

  <h2 class="post-title">
    <a href={`/novedades/${n.id}/`}>{n.data.title}</a>
  </h2>

  <p class="post-excerpt">{n.data.description}</p>

  <footer class="post-footer">
    <span class="post-source">Fuente: <strong>{n.data.source}</strong></span>
    <a class="post-read" href={`/novedades/${n.id}/`} aria-hidden="true" tabindex="-1">
      Leer resumen →
    </a>
  </footer>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.35rem 1.5rem;
    border: 1.5px solid color-mix(in srgb, currentColor 16%, transparent);
    border-radius: 14px;
    background: transparent;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .post-card:hover {
    border-color: color-mix(in srgb, currentColor 45%, transparent);
    transform: translateY(-2px);
  }

  /* Nivel 1: Categoría + Fecha arriba, siempre visibles */
  .post-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 1.6rem;
  }

  .post-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    background: color-mix(in srgb, currentColor 10%, transparent);
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  .post-badge:hover {
    background: color-mix(in srgb, currentColor 18%, transparent);
  }

  .post-date {
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, currentColor 70%, transparent);
  }

  /* Nivel 2: Titular claro y legible */
  .post-title {
    margin: 0;
    font-size: 1.22rem;
    font-weight: 750;
    line-height: 1.32;
    letter-spacing: -0.01em;
  }

  .post-title a {
    color: inherit;
    text-decoration: none;
  }

  .post-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }

  /* Nivel 3: Resumen escaneable */
  .post-excerpt {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: color-mix(in srgb, currentColor 82%, transparent);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Pie minimalista */
  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid color-mix(in srgb, currentColor 10%, transparent);
    font-size: 0.82rem;
  }

  .post-source {
    color: color-mix(in srgb, currentColor 70%, transparent);
  }

  .post-read {
    font-weight: 650;
    color: inherit;
    text-decoration: none;
  }

  .post-card:hover .post-read {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>